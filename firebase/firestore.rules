rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() ? request.auth.token.email : null;
    }

    // This project stores users by email as document id.
    function userDocExists() {
      return isSignedIn() && authEmail() != null
        && exists(/databases/$(database)/documents/users/$(authEmail()));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(authEmail())).data.role
        : null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        userRole() == 'teacher'
      );
    }

    function isTestCreator() {
      return isSignedIn() && (
        request.auth.token.role == 'testCreator' ||
        userRole() == 'testCreator'
      );
    }

    function isStudent() {
      return isSignedIn() && (
        request.auth.token.role == 'student' ||
        userRole() == 'student'
      );
    }

    function isTeacherOrCreator() {
      return isTeacher() || isTestCreator();
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    // users collection (doc id = email)
    match /users/{docId} {
      allow read: if isSignedIn() && (
        docId == authEmail() ||
        isTeacherOrCreator()
      );

      // Writes should go through privileged backend.
      allow create, update: if false;

      allow delete: if isSignedIn() && (
        docId == authEmail() ||
        isTeacherOrCreator()
      );
    }

    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrCreator();

      // Allow teacher/testCreator to delete old tests even when ownerUid is missing/legacy.
      allow update: if isTeacherOrCreator() && (
        !('ownerUid' in resource.data) ||
        isOwner(resource.data.ownerUid)
      );
      allow delete: if isTeacherOrCreator();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrCreator();
      allow update, delete: if isTeacherOrCreator() && (
        !('ownerUid' in resource.data) ||
        isOwner(resource.data.ownerUid)
      );
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentUid ||
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid;

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.studentUid ||
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      allow delete: if isTeacherOrCreator();
    }

    match /testResults/{resultId} {
      allow read: if isSignedIn() && (
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      allow create: if isStudent() && request.resource.data.studentEmail == authEmail();

      allow update: if isSignedIn() && (
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      allow delete: if isTeacherOrCreator();
    }

    match /writing/{attemptId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentUid ||
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      allow create: if isStudent() && request.resource.data.studentUid == request.auth.uid;

      allow update: if isTeacherOrCreator();

      allow delete: if isTeacherOrCreator();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrCreator();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
