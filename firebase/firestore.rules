rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() ? request.auth.token.email : null;
    }

    // This project stores users by email as document id.
    function userDocExists() {
      return isSignedIn() && authEmail() != null
        && exists(/databases/$(database)/documents/users/$(authEmail()));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(authEmail())).data.role
        : null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        userRole() == 'teacher'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        userRole() == 'admin'
      );
    }

    function isTestCreator() {
      return isSignedIn() && (
        request.auth.token.role == 'testCreator' ||
        userRole() == 'testCreator'
      );
    }

    function isStudent() {
      return isSignedIn() && (
        request.auth.token.role == 'student' ||
        userRole() == 'student'
      );
    }

    function isTeacherOrCreator() {
      return isTeacher() || isTestCreator() || isAdmin();
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function studentClassId() {
      return userDocExists() && ('classId' in get(/databases/$(database)/documents/users/$(authEmail())).data)
        ? get(/databases/$(database)/documents/users/$(authEmail())).data.classId
        : null;
    }

    function studentClassCode() {
      return userDocExists() && ('classCode' in get(/databases/$(database)/documents/users/$(authEmail())).data)
        ? get(/databases/$(database)/documents/users/$(authEmail())).data.classCode
        : null;
    }

    function isAssignedTest(testData) {
      return isStudent() && (
        !('classAssignment' in testData) ||
        !('selectedClasses' in testData.classAssignment) ||
        testData.classAssignment.selectedClasses.size() == 0 ||
        studentClassId() in testData.classAssignment.selectedClasses ||
        studentClassCode() in testData.classAssignment.selectedClasses
      );
    }

    function hasActiveTestLock(testId) {
      return exists(/databases/$(database)/documents/testAccessLocks/$(testId + '--' + request.auth.uid)) &&
        get(/databases/$(database)/documents/testAccessLocks/$(testId + '--' + request.auth.uid)).data.status == 'locked';
    }

    // users collection (doc id = email)
    match /users/{docId} {
      allow read: if isSignedIn() && (
        docId == authEmail() ||
        isTeacherOrCreator()
      );

      // Writes should go through privileged backend.
      allow create, update: if false;

      allow delete: if isSignedIn() && (
        docId == authEmail() ||
        isTeacherOrCreator()
      );
    }

    match /tests/{testId} {
      // Test material is served by getTest, which verifies assignment and lock
      // status and replaces storage URLs with revocable access sessions.
      allow get: if isTeacherOrCreator();
      allow list: if isTeacherOrCreator();
      allow create: if isTeacherOrCreator();

      // Allow teacher/testCreator to delete old tests even when ownerUid is missing/legacy.
      allow update: if isTeacherOrCreator() && (
        !('ownerUid' in resource.data) ||
        isOwner(resource.data.ownerUid)
      );
      allow delete: if isTeacherOrCreator();
    }

    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrCreator();
      allow update, delete: if isTeacherOrCreator() && (
        !('ownerUid' in resource.data) ||
        isOwner(resource.data.ownerUid)
      );
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentUid ||
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      // Attempt lifecycle writes go through authenticated backend functions so
      // lock checks and status transitions are atomic.
      allow create, update: if isTeacherOrCreator();

      allow delete: if isTeacherOrCreator();

      match /violations/{violationId} {
        allow read: if isTeacherOrCreator();
        allow write: if false;
      }
    }

    match /testResults/{resultId} {
      allow read: if isSignedIn() && (
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      // Student autosave and submit go through backend lock enforcement.
      allow create, update: if isTeacherOrCreator();

      allow delete: if isTeacherOrCreator();
    }

    match /writing/{attemptId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentUid ||
        authEmail() == resource.data.studentEmail ||
        isTeacherOrCreator()
      );

      // Student submissions are created through submitAttempt so lock and
      // ownership checks cannot be bypassed through this legacy collection.
      allow create: if isTeacherOrCreator();

      allow update: if isTeacherOrCreator();

      allow delete: if isTeacherOrCreator();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isTeacherOrCreator();
    }

    match /testAccessLocks/{lockId} {
      allow read: if isTeacherOrCreator() || (
        isStudent() && resource.data.studentUid == request.auth.uid
      );
      allow write: if false;

      match /events/{eventId} {
        allow read: if isTeacherOrCreator();
        allow write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
