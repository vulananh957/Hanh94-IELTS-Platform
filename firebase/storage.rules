rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Test materials are delivered through the access-checked getTestMaterial
    // Function. They must never be fetched directly from Storage by a student.
    match /tests/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
    
    // Allow authenticated users to manage their writing submissions
    match /writing/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to upload teacher feedback files for writing
    // Students need to read these files after grading, so keep read open to
    // signed-in users.
    match /manual-grading-feedback/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Anti-cheat: violation screenshots uploaded by students during tests.
    // Students can only write (upload) their own photos; they cannot read
    // others' photos. Teachers (identified by custom claims or no testId match)
    // can read these files to review flagged attempts.
    match /violations/{studentUid}/{testId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == studentUid;
    }

    // Structured monitoring evidence for new Attempts. The folder labels are
    // teacher-readable, while the Student UID suffix still limits uploads to
    // the authenticated Student.
    match /monitoring-evidence/{testFolder}/{className}/{studentFolder}/{attemptFolder}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && studentFolder.matches('.*--' + request.auth.uid)
        && request.resource.contentType == 'image/jpeg';
    }
    
    // Allow public read of feedback files (teacher already provided to student)
    match /feedback/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
