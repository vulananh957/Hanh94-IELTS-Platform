rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read test materials
    match /tests/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Allow authenticated users to manage their writing submissions
    match /writing/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to read feedback files
    match /feedback/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
