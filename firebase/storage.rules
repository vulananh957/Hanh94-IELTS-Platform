rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read of test materials (PDF, audio)
    // These are learning materials, safe to be public
    match /tests/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow authenticated users to manage their writing submissions
    match /writing/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow public read of feedback files (teacher already provided to student)
    match /feedback/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
